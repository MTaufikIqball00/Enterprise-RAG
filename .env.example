# ============================================================================
# ENTERPRISE RAG SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# PERINGATAN KEAMANAN: Jangan pernah menaruh API key, password, atau secret
# asli di dalam file ini. Salin file ini menjadi `.env` untuk konfigurasi lokal.

APP_NAME="Enterprise RAG System"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=false

# Security & JWT Configuration
# Ganti nilai di bawah pada file .env lokal menggunakan string acak minimal 32 byte
JWT_SECRET_KEY="CHANGE_ME_IN_LOCAL_ENV_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (SQLite Local Persistence by default)
DATABASE_URL="sqlite:///./storage/enterprise_rag.db"

# Vector Database Configuration (Qdrant Local Persistence)
QDRANT_STORAGE_PATH="./storage/qdrant"
QDRANT_COLLECTION_NAME="enterprise_documents"
EMBEDDING_DIMENSION=256

# File Storage Configuration
RAW_DOCUMENT_STORAGE_PATH="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunking Configuration
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# LLM & Embedding Provider Configuration
# Pilihan LLM_PROVIDER: "local_grounded" | "openai" | "gemini"
LLM_PROVIDER="local_grounded"
LLM_MODEL_NAME="local-extractive-grounded-v1"

# Pilihan EMBEDDING_PROVIDER: "local_deterministic" | "openai" | "gemini"
EMBEDDING_PROVIDER="local_deterministic"
EMBEDDING_MODEL_NAME="local-hash-ngram-256d-v1"

# Cloud Provider Keys (Kosongkan jika menggunakan mode local_grounded / local_deterministic)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS Allowed Origins (React Vite Frontend)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
