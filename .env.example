# ============================================================================
# ENTERPRISE RAG SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# PERINGATAN KEAMANAN: Jangan pernah menaruh API key, password, atau secret
# asli di dalam file ini. Salin file ini menjadi `.env` untuk konfigurasi lokal.

APP_NAME="Enterprise RAG System"
APP_ENV="development"
APP_VERSION="0.2.0"
DEBUG=false

HOST="127.0.0.1"
BACKEND_PORT=8010

# Security & JWT Configuration
# WAJIB diganti saat APP_ENV != "development" (minimal 32 byte acak, tanpa placeholder CHANGE_ME)
JWT_SECRET_KEY="CHANGE_ME_IN_LOCAL_ENV_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo Accounts Seeding & Login Quick-Selector (default true hanya pada APP_ENV=development)
ENABLE_DEMO_ACCOUNTS=true

# Database Configuration (SQLite Local Persistence dengan PRAGMA foreign_keys=ON & WAL mode)
DATABASE_URL="sqlite:///./storage/enterprise_rag.db"

# Hybrid Vector & Optional External Qdrant Configuration
# Kosongkan QDRANT_URL untuk menggunakan SQLite Persistent Embeddings + FTS5 BM25 Hybrid RRF bawaan
QDRANT_URL=""
QDRANT_COLLECTION_NAME="enterprise_documents"
EMBEDDING_DIMENSION=256

# File Storage Configuration
RAW_DOCUMENT_STORAGE_PATH="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunking & Hybrid Retrieval Configuration
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.05

# Bounded Cache (Moka) & Rate Limiting Configuration
CACHE_MAX_CAPACITY=500
CACHE_TTL_SECS=300
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=60

# LLM & Embedding Provider Configuration
# Pilihan LLM_PROVIDER: "local_grounded" | "openai" | "gemini"
LLM_PROVIDER="local_grounded"
LLM_MODEL_NAME="local-extractive-grounded-v1"

# Pilihan EMBEDDING_PROVIDER: "local_deterministic" | "openai" | "gemini"
EMBEDDING_PROVIDER="local_deterministic"
EMBEDDING_MODEL_NAME="local-hash-ngram-256d-v1"

# Cloud Provider Keys (Kosongkan jika menggunakan mode local_grounded / local_deterministic)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS Allowed Origins Allowlist (dipisahkan koma)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
